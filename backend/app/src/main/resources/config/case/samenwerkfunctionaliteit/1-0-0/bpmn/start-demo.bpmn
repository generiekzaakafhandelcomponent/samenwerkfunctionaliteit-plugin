    </bpmn:startEvent>
    <bpmn:endEvent id="end-event" name="Process ended">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${valueResolverDelegateService.handleValue(execution, &#39;doc:/apiResult&#39;, execution.getVariable(&#39;apiResult&#39;))}" event="start" />
        <camunda:executionListener expression="${valueResolverDelegateService.handleValue(execution, &#39;doc:/message&#39;, execution.getVariable(&#39;message&#39;))}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start-event" targetRef="end-event" />
  </bpmn:process>
